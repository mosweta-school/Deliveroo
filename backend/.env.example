# --- App ---
APP_NAME=Deliveroo API
ENVIRONMENT=development
SECRET_KEY=abrahwbfgsvnefdvhwvfydsbvhdnbfhjbfdbhwbdsfbwhbfdhbahsvfebbfhrywebfdsher47569284@dbhevfadbfhsdbcdsbcb

# --- Database (Supabase) ---
# Use the "Direct connection" string (port 5432) for local dev / Flask-Migrate.
# If you later split read traffic through the pooler, add DATABASE_URL_POOLED separately.
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Auth (Flask-JWT-Extended) ---
JWT_SECRET_KEY=abrahwbfgsvnefdvhwvfydsbvhdnbfhjbfdbhwbdsfbwhbfdhbahsvfebbfhrywebfdsher47569284@dbhevfadbfhsdbcdsbcb
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (Flask-Mail) — used for status/location update notifications ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
EMAIL=deliveroo5768@gmail.com
EMAIL_PASSWORD=your-app-password

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- M-Pesa STK Push ---
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
